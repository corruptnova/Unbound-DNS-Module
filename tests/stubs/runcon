#!/bin/sh
# Fake runcon, parsing like BusyBox's (what root managers' scripts get):
# options are read anywhere until "--", so "runcon CONTEXT PROG -x" fails
# with its usage text. Records the call and runs PROG in this process;
# $STUB_STATE/runcon.fail makes the domain change fail.
echo "runcon $*" >> "$STUB_STATE/calls.log"
usage() {
    printf 'Usage: runcon [-c] [-u USER] [-r ROLE] [-t TYPE] [-l RANGE] PROG ARGS\n\t-r ROLE\tRole\n\t-l RNG\tLevelrange\n' >&2
    exit 1
}
n=$#; i=0; ends=0; opt_arg=0
for a in "$@"; do
    i=$((i + 1))
    if [ "$ends" = 1 ]; then continue; fi
    if [ "$opt_arg" = 1 ]; then opt_arg=0; continue; fi
    case "$a" in
        --) ends=1; dd=$i ;;
        -r|-t|-u|-l) opt_arg=1 ;;
        -c|-h) ;;
        -?*) usage ;;
    esac
done
[ "$n" -ge 2 ] || usage
# Only the form the module uses is run: runcon -- CONTEXT PROG [ARG...]
[ "${dd:-0}" = 1 ] || { echo "runcon (stub): only 'runcon -- CONTEXT PROG' is emulated" >&2; exit 1; }
shift
if [ -f "$STUB_STATE/runcon.fail" ]; then
    echo "runcon: can't set up security context '$1'" >&2
    exit 1
fi
shift
exec "$@"

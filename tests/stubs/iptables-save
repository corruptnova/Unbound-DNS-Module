#!/bin/sh
# Fake iptables-save / ip6tables-save: prints one table of the fake rules
# (see iptables) in iptables-save format. Like the real one it takes no lock.
# Behaves like a missing command when $STUB_STATE/nosave exists.
name="${0##*/}"
ipt="${name%-save}"
[ -f "$STUB_STATE/nosave" ] && exit 127
echo "$name $*" >> "$STUB_STATE/calls.log"
table=filter
while [ $# -gt 0 ]; do
    case "$1" in -t) table="$2"; shift 2 ;; *) shift ;; esac
done
if [ "$table" = nat ] && [ -f "$STUB_STATE/$ipt.nonat" ]; then
    echo "$name: table nat does not exist" >&2
    exit 1
fi
dir="$STUB_STATE/$ipt/$table"
echo "*$table"
for f in "$dir"/*; do
    [ -f "$f" ] || continue
    case "$f" in *.tmp) continue ;; esac
    echo ":${f##*/} - [0:0]"
done
for f in "$dir"/*; do
    [ -f "$f" ] || continue
    case "$f" in *.tmp) continue ;; esac
    while IFS= read -r r; do echo "-A ${f##*/} $r"; done < "$f"
done
echo COMMIT
